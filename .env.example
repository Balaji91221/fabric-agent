# ---- Agent identity -------------------------------------------------
AGENT_MODEL_ID=fabric-semantic-agent
AGENT_DISPLAY_NAME=Fabric Semantic Model Agent
AGENT_MAX_TOOL_TURNS=6
AGENT_MAX_ROWS=200

# ---- Microsoft Fabric semantic model --------------------------------
# Leave blank to run against the built-in demo model.
# Service principal needs "Read" + "Build" on the semantic model, and the
# tenant setting "Dataset Execute Queries REST API" must be enabled.
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE_ID=
FABRIC_DATASET_ID=

# ---- Reasoning model (any OpenAI-compatible endpoint) ---------------
# Leave LLM_API_KEY blank to use the built-in deterministic planner.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Serving --------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ---- Keys -----------------------------------------------------------
# A demo key is generated on first boot and written to .demo_key.
# Set DEMO_API_KEY to pin it, API_KEYS for real clients (comma separated).
DEMO_API_KEY=
API_KEYS=
EXPOSE_DEMO_KEY=true
